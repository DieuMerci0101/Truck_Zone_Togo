        {
          "name": "Register Chauffeur",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom_complet\": \"Kofi Amedee\",\n  \"email\": \"kofi.chauffeur@email.com\",\n  \"password\": \"TestPass123!\",\n  \"confirm_password\": \"TestPass123!\",\n  \"telephone\": \"+22891234567\",\n  \"role\": \"chauffeur\"\n}"
            },
