          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var jsonData = pm.response.json();",
                "if (jsonData.id) { pm.collectionVariables.set('user_id', jsonData.id); }",
                "console.log('User ID:', jsonData.id);"
              ]
