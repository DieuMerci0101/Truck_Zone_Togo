{
  "info": {
    "name": "Togo Truck Connect API",
    "description": "API complète pour Togo Truck Connect — 60+ endpoints\n\nUtilisation:\n1. Commencer par Health check\n2. Register un utilisateur\n3. Login pour obtenir le token\n4. Utiliser le token dans Authorization > Bearer Token\n\nComptes de test:\n- Admin: admin@togotruckconnect.com / Admin@2026\n- Chauffeur: test@email.com / testpass123\n- Proprietaire: abi.proprietaire@email.com / testpass123\n- Mecanicien: amadou.meca@email.com / testpass123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "chauffeur_profile_id", "value": "" },
    { "key": "proprietaire_profile_id", "value": "" },
    { "key": "mecanicien_profile_id", "value": "" },
    { "key": "conversation_id", "value": "" },
    { "key": "incident_id", "value": "" },
    { "key": "camion_id", "value": "" },
    { "key": "offre_id", "value": "" },
    { "key": "notification_id", "value": "" },
    { "key": "document_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health & Docs",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/",
            "description": "Vérifie que l'API est en ligne"
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "description": "Health check endpoint"
          }
        },
        {
          "name": "Swagger Docs",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/docs",
            "description": "Documentation Swagger interactive"
          }
        }
      ]
    },
    {
