# ─────────────────────────────────────────────────────────────
# Togo Truck Connect — Backend (FastAPI)
# Copier ce fichier en `.env` et adapter les valeurs.
# Aucun secret réel ne doit être commité.
# ─────────────────────────────────────────────────────────────

# ── Base de données ─────────────────────────────────────────
# En production (Render) : l'URL est fournie automatiquement par le
# service PostgreSQL (format `postgresql://user:pass@host:port/db`).
DATABASE_URL=postgresql://togotruck:togotruck_secret_2026@localhost:5432/togotruckconnect
DATABASE_URL_ASYNC=postgresql+asyncpg://togotruck:togotruck_secret_2026@localhost:5432/togotruckconnect

# ── JWT ─────────────────────────────────────────────────────
# IMPORTANT : générer une valeur aléatoire forte pour la production.
# Exemple : `openssl rand -hex 32`
SECRET_KEY=togotruck_secret_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ────────────────────────────────────────────────────
# Liste d'origines autorisées, séparées par des virgules.
# Par défaut : frontend Vercel de production + environnements locaux.
ALLOWED_ORIGINS=https://frontend-truck-zone-togo.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# ── Frontend public ─────────────────────────────────────────
# URL utilisée dans les emails et redirections (défaut : production Vercel).
FRONTEND_URL=https://frontend-truck-zone-togo.vercel.app

# ── SMTP / Emails ─────────────────────────────────────────
# MODE API (RECOMMANDÉ sur Render) : Depuis le 26/09/2025, Render BLOQUE le
# SMTP sortant (ports 25/465/587) sur les web services GRATUITS. Utiliser donc
# l'API HTTP Brevo (port 443, jamais bloqué) :
#   1. Crée un compte sur brevo.com (gratuit, 300 emails/jour).
#   2. Settings > SMTP & API > API Keys : crée une clé API (xkeysib-…) =
#      BREVO_API_KEY.
#   3. Settings > Senders & IPs : VÉRIFIE l'adresse d'envoi de EMAIL_FROM.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# MODE SMTP (dev local / serveurs non bloqués) : Brevo accepte aussi le SMTP
# (smtp-relay.brevo.com:587) — utile si Render devient payant.
#   1. Settings > SMTP & API : génère une clé SMTP (xsmtpsib-…).
#      Le « SMTP Login » affiché (format xxx@smtp-brevo.com) = MAIL_USERNAME.
#   2. Settings > Senders & IPs : VÉRIFIE l'adresse d'envoi de MAIL_FROM.
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
# Ton « SMTP Login » Brevo (pas ton email de compte) :
MAIL_USERNAME=xxxx@smtp-brevo.com
# Ta clé SMTP Brevo (pas ton mot de passe Brevo) :
MAIL_PASSWORD=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxx
# Adresse d'envoi — doit être vérifiée dans Brevo (Senders & IPs) :
MAIL_FROM=patgodson01@gmail.com
# Aliases SMTP_* équivalents (un seul jeu suffit) :
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, EMAIL_FROM
#
# ALTERNATIVE : Gmail (peut échouer depuis Render : Google bloque le SMTP
# sortant des IP cloud). Mêmes variables, serveur smtp.gmail.com, port 587,
# MAIL_USERNAME=ton@gmail.com, MAIL_PASSWORD=mot de passe d'application.

# ── MinIO (facultatif, stockage objet) ──────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=togotruck_minio
MINIO_SECRET_KEY=togotruck_minio_2026
MINIO_BUCKET=togotruck-uploads

# ── Supabase Storage (RECOMMANDÉ sur Render) ────────────────
# Le disque de Render est EFFACÉ à chaque redémarrage : les fichiers uploadés
# en local sont perdus. Avec Supabase, les fichiers vont sur un bucket PUBLIC
# (URLs permanentes, aucune perte). Procédure :
#   1. https://supabase.com → New project (gratuit, 1 Go de stockage).
#   2. Storage → New bucket : nom « truckzone », sélectionner « Public ».
#   3. Project Settings → API : copier « Project URL » et la clé
#      « service_role » (secrète — jamais exposée au frontend).
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... (clé service_role)
SUPABASE_BUCKET=truckzone

# ── Redis (facultatif, cache / websockets) ──────────────────
REDIS_URL=redis://localhost:6379/0

# ── Web Push (PWA — notifications navigateur) ────────────────
# Générer les clés : `pip install py-vapid && python -m py_vapid --gen` (ou la
# commande Vapid02 du package pywebpush). Puis :
#   VAPID_PUBLIC_KEY : chaîne base64url (celle exposée au navigateur).
#   VAPID_PRIVATE_KEY : PEM, ou base64 du PEM (une seule ligne, .env friendly).
# Si absentes, les notifications push sont simplement ignorées.
VAPID_PUBLIC_KEY=BMrQs1nkt66qoK7c_PwBhtWF2shmPKN1mtJJKhNl7kqgALdapDhQRd9yltMBMtReuTET5CIcGb5pfwf3z1Fj8uI
VAPID_PRIVATE_KEY=<PEM ou base64 du PEM>
VAPID_SUBJECT=mailto:patgodson01@gmail.com

# ── SMS de secours (urgences) — API Brevo ────────────────────
# Nécessite des crédits SMS Brevo (Settings > SMS). Numéros internationaux
# (+228…). Si non configuré, les SMS sont ignorés sans casser le flux.
SMS_SENDER=TruckZone
