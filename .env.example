# ─────────────────────────────────────────────────────────────
# Togo Truck Connect — Backend (FastAPI)
# Copier ce fichier en `.env` et adapter les valeurs.
# Aucun secret réel ne doit être commité.
# ─────────────────────────────────────────────────────────────

# ── Base de données ─────────────────────────────────────────
# En production (Render) : l'URL est fournie automatiquement par le
# service PostgreSQL (format `postgresql://user:pass@host:port/db`).
DATABASE_URL=postgresql://togotruck:togotruck_secret_2026@localhost:5432/togotruckconnect
DATABASE_URL_ASYNC=postgresql+asyncpg://togotruck:togotruck_secret_2026@localhost:5432/togotruckconnect

# ── JWT ─────────────────────────────────────────────────────
# IMPORTANT : générer une valeur aléatoire forte pour la production.
# Exemple : `openssl rand -hex 32`
SECRET_KEY=togotruck_secret_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ────────────────────────────────────────────────────
# Liste d'origines autorisées, séparées par des virgules.
# Par défaut : frontend Vercel de production + environnements locaux.
ALLOWED_ORIGINS=https://frontend-truck-zone-togo.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# ── Frontend public ─────────────────────────────────────────
# URL utilisée dans les emails et redirections (défaut : production Vercel).
FRONTEND_URL=https://frontend-truck-zone-togo.vercel.app

# ── SMTP (emails OTP, validation/rejet de compte) ──────────
# Les deux jeux de variables sont acceptés (MAIL_* = convention Flask-Mail,
# SMTP_* = convention interne) ; un seul suffit. En prod, les définir sur Render.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
# Compte SMTP authentifié (Gmail : utiliser un "mot de passe d'application"
# à 16 caractères généré dans https://myaccount.google.com/apppasswords).
MAIL_USERNAME=patgodson01@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
# Expéditeur affiché. SI VIDE, l'email est envoyé depuis MAIL_USERNAME
# (recommandé avec Gmail pour la délivrabilité SPF/DKIM).
MAIL_FROM=patgodson01@gmail.com
# Aliases SMTP_* équivalents :
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, EMAIL_FROM

# ── MinIO (facultatif, stockage objet) ──────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=togotruck_minio
MINIO_SECRET_KEY=togotruck_minio_2026
MINIO_BUCKET=togotruck-uploads

# ── Redis (facultatif, cache / websockets) ──────────────────
REDIS_URL=redis://localhost:6379/0
